<% status = @environment.status %>
<% bro_hub_crumb @environment.name, "Not available" %>
<%= bro_hub_hero eyebrow: "#{@environment.name} credentials", title: "Not available", tone: :red,
      lead: begin
        case status
        when :missing_file
          safe_join([ "There is no credentials file at ", tag.code(env_bro_display_path(@environment.content_path)), " on this server." ])
        when :missing_key
          safe_join([ "This server has no key for ", tag.code(@environment.filename), ". Set ", tag.code(@environment.env_key),
            " or add ", tag.code(env_bro_display_path(@environment.key_path)), "." ])
        else
          safe_join([ "The key on this server (", tag.code(@environment.env_key), " or ", tag.code(env_bro_display_path(@environment.key_path)),
            ") cannot decrypt ", tag.code(@environment.filename), "." ])
        end
      end do %>
  <p style="margin-top:16px"><%= env_bro_environment_badge(status) %></p>
<% end %>
