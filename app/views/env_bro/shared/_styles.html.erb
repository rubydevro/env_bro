<style nonce="<%= content_security_policy_nonce %>">
  :root {
    --bg: #f6f7f9; --panel: #ffffff; --text: #1d2330; --muted: #6b7385; --border: #e1e4ea;
    --accent: #3b5bdb; --accent-text: #ffffff; --danger: #c92a2a; --warn-bg: #fff4e0; --warn: #9a5b00;
    --ok-bg: #e6f6ec; --ok: #1f7a3f; --code-bg: #f1f3f6;
    --added: #1f7a3f; --added-bg: #e6f6ec; --removed: #c92a2a; --removed-bg: #fdecec;
    --changed: #9a5b00; --changed-bg: #fff4e0;
    --radius: 8px;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151b; --panel: #1b1f27; --text: #e4e7ee; --muted: #8d95a7; --border: #2c323d;
      --accent: #6d8bff; --accent-text: #0d1020; --danger: #ff6b6b; --warn-bg: #3a2c12; --warn: #ffc566;
      --ok-bg: #143122; --ok: #6fdc98; --code-bg: #232833;
      --added: #6fdc98; --added-bg: #143122; --removed: #ff8787; --removed-bg: #3a1a1a;
      --changed: #ffc566; --changed-bg: #3a2c12;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { font-size: 1.5rem; margin: 0 0 4px; }
  h2 { font-size: 1.1rem; margin: 0 0 12px; }
  p { margin: 0 0 12px; }
  code, .mono { font-family: var(--mono); font-size: .9em; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  main.wrap { padding-top: 24px; padding-bottom: 64px; }

  .topbar { background: var(--panel); border-bottom: 1px solid var(--border); }
  .topbar-inner { display: flex; align-items: center; gap: 24px; height: 56px; }
  .brand { font-weight: 700; color: var(--text); font-size: 1.05rem; }
  .brand:hover { text-decoration: none; }
  .nav { display: flex; gap: 16px; flex: 1; }
  .nav a { color: var(--muted); }
  .nav a:hover { color: var(--text); text-decoration: none; }

  .page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }

  .panel { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 20px; }
  .split { display: grid; grid-template-columns: 1fr 320px; gap: 20px; align-items: start; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }


  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 6px;
    border: 1px solid var(--border); background: var(--panel); color: var(--text); font: inherit; font-size: .9rem;
    cursor: pointer; line-height: 1.2; }
  .btn:hover { text-decoration: none; border-color: var(--muted); }
  .btn-primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
  .btn-primary:hover { filter: brightness(1.08); border-color: var(--accent); }
  .btn-small { padding: 3px 8px; font-size: .8rem; }
  .btn-link { background: none; border: none; color: var(--accent); padding: 0; cursor: pointer; font: inherit; font-size: .85rem; }
  .btn-danger { color: var(--danger); }
  .btn[disabled] { opacity: .5; cursor: not-allowed; }

  label { display: block; font-weight: 600; font-size: .85rem; margin-bottom: 4px; }
  input[type=text], input[type=search], select, textarea {
    width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px;
    background: var(--bg); color: var(--text); font: inherit; }
  textarea { font-family: var(--mono); font-size: .85rem; min-height: 38px; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  input[type=file] { font: inherit; font-size: .9rem; }
  .field { margin-bottom: 16px; }
  .hint { font-size: .8rem; color: var(--muted); margin-top: 4px; font-weight: normal; }

  .alert { padding: 12px 14px; border-radius: 6px; margin-bottom: 16px; font-size: .9rem; }
  .alert-error { background: var(--removed-bg); color: var(--removed); }
  .alert-warn { background: var(--warn-bg); color: var(--warn); }
  .alert-ok { background: var(--ok-bg); color: var(--ok); }

  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; }
  tr:last-child td { border-bottom: none; }
  td.key { font-family: var(--mono); font-size: .85rem; overflow-wrap: anywhere; min-width: 180px; }
  td.nowrap, th.nowrap { white-space: nowrap; }
  .row-added td.key { color: var(--added); }
  .row-removed td.key { color: var(--removed); }
  .row-changed td.key { color: var(--changed); }
  .row-unchanged { color: var(--muted); }

  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .75rem; font-weight: 600; }
  .badge-added { background: var(--added-bg); color: var(--added); }
  .badge-removed { background: var(--removed-bg); color: var(--removed); }
  .badge-changed { background: var(--changed-bg); color: var(--changed); }
  .badge-unchanged, .badge-neutral { background: var(--code-bg); color: var(--muted); }
  .badge-ok { background: var(--ok-bg); color: var(--ok); }
  .badge-danger { background: var(--removed-bg); color: var(--removed); }

  .mask { letter-spacing: 2px; color: var(--muted); }
  code.value { display: inline-block; background: var(--code-bg); padding: 2px 6px; border-radius: 4px;
    white-space: pre-wrap; word-break: break-all; max-width: 100%; }

  .panel-flush { padding: 0; overflow: hidden; }
  .panel-pad { padding: 16px 20px 0; }
  .filter { max-width: 240px; padding: 6px 10px; font-size: .85rem; }
  .hidden { display: none !important; }
  .icon-btn { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1rem; padding: 6px; border-radius: 4px; }
  .icon-btn:hover { color: var(--danger); background: var(--removed-bg); }

  .newkey-row { display: grid; grid-template-columns: minmax(180px, 2fr) 3fr 32px; gap: 8px; margin-bottom: 8px; align-items: start; }
  @media (max-width: 640px) { .newkey-row { grid-template-columns: 1fr 32px; } .newkey-row textarea { grid-column: 1; } }

  /* Existing keys, laid out like the YAML file. */
  .yaml { font-family: var(--mono); font-size: .875rem; border-top: 1px solid var(--border); margin-top: 16px; }
  .yaml-line { display: grid; grid-template-columns: minmax(200px, 38%) 1fr auto; gap: 12px; align-items: center;
    padding: 4px 20px; border-left: 3px solid transparent; }
  .yaml-line:hover { background: var(--code-bg); }
  .yaml-group { padding-top: 10px; padding-bottom: 2px; }
  .yaml-group:hover { background: none; }
  .yaml-group .yaml-key { color: var(--muted); font-weight: 600; }
  .yaml-key { font-weight: normal; font-size: inherit; margin: 0; overflow-wrap: anywhere; cursor: text; }
  .depth-1 { padding-left: 20px; } .depth-2 { padding-left: 40px; } .depth-3 { padding-left: 60px; }
  .depth-4 { padding-left: 80px; } .depth-5 { padding-left: 100px; } .depth-6 { padding-left: 120px; }
  .yaml-line textarea, .newkey-row textarea { resize: none; overflow: hidden; }
  .yaml-line textarea { min-height: 32px; padding: 5px 10px; background: transparent; border-color: transparent; }
  .yaml-line:hover textarea, .yaml-line textarea:focus { background: var(--bg); border-color: var(--border); }
  .yaml-line textarea::placeholder { color: var(--muted); letter-spacing: 1px; }
  .yaml-line.is-changed { border-left-color: var(--changed); background: var(--changed-bg); }
  .yaml-line.is-changed .yaml-key { color: var(--changed); }
  .yaml-line.is-changed textarea { background: var(--bg); border-color: var(--border); }
  .yaml-line.is-removed { border-left-color: var(--removed); background: var(--removed-bg); }
  .yaml-line.is-removed .yaml-key { color: var(--removed); text-decoration: line-through; }
  .yaml-line.is-removed textarea { visibility: hidden; }
  .remove-toggle { display: flex; align-items: center; gap: 4px; margin: 0; font: inherit; font-size: .8rem; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: normal; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .yaml-line.is-removed .remove-toggle { color: var(--removed); }
  .yaml .empty { font-family: inherit; }

  .submitbar { position: sticky; bottom: 0; z-index: 5; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 20px; margin-bottom: 16px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, .08); }
  .submitbar [data-summary].has-changes { color: var(--text); font-weight: 600; }

  .steps { margin: 0; padding-left: 20px; font-size: .9rem; }
  .steps li { margin-bottom: 6px; overflow-wrap: anywhere; }
  .meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; font-size: .9rem; margin: 0; }
  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; }
  .summary { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
  .empty { text-align: center; padding: 32px; color: var(--muted); }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .toolbar h2 { margin: 0; }
  .mt-12 { margin-top: 12px; }
  .mt-16 { margin-top: 16px; margin-bottom: 0; }
  details summary { cursor: pointer; color: var(--muted); font-size: .9rem; }
</style>
