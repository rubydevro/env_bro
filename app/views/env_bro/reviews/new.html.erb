<% env_bro_styles %>
<% bro_hub_crumb @environment.name, "Review a proposed file" %>
<%= bro_hub_hero eyebrow: @environment.filename, title: "Review", subtitle: "a proposed file", tone: :green,
      lead: safe_join([ "Upload the ", tag.code(@environment.filename), " from the pull request to see which keys it changes." ]) %>

<% if @error %>
  <div class="eb-banner is-error"><%= @error %></div>
<% end %>

<%= form_with url: review_path, method: :post, multipart: true, local: true, data: { turbo: false } do %>
  <section class="bh-block eb-file">
    <div class="field">
      <label class="bh-field" for="proposed_file">Proposed file
        <input type="file" name="proposed_file" id="proposed_file" accept=".enc" required class="bh-input">
      </label>
      <p class="eb-note">Download it from the PR branch, e.g. <code>git show my-branch:<%= env_bro_display_path(@environment.content_path) %> &gt; <%= @environment.filename %></code>.</p>
    </div>

    <details class="eb-details" style="margin-top:28px">
      <summary>Compare against another version (optional)</summary>
      <label class="bh-field" for="base_file">Base file
        <input type="file" name="base_file" id="base_file" accept=".enc" class="bh-input">
      </label>
      <p class="eb-note">By default the proposal is compared with the file deployed on this server. Upload the file from <code>main</code> if it is ahead of what's deployed.</p>
    </details>

    <button type="submit" class="bh-btn is-green is-auto" style="margin-top:28px">Show changes</button>
  </section>
<% end %>
