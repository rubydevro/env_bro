<% env_bro_styles %>
<% can_reveal = env_bro_can?(:reveal) %>
<% meta = @differ.proposed_metadata %>
<% changes = @differ.changes %>
<% unchanged = @differ.entries.reject(&:changed?) %>
<% bro_hub_crumb @environment.name, "Review" %>
<% content_for :bro_hub_crumb_actions do %><%= bro_hub_crumb_link "Review another file", new_review_path %><% end %>

<%= bro_hub_hero eyebrow: "#{@environment.name} · #{@environment.filename}", title: changes.size.to_s,
      subtitle: "changed #{changes.size == 1 ? 'key' : 'keys'}", tone: (changes.any? ? :amber : :green),
      lead: safe_join([ "Proposed changes to #{@environment.name}, compared against the #{@base_enc ? 'uploaded base file' : 'file deployed on this server'} (",
        tag.code(env_bro_short_digest(@base_digest)), ")." ]),
      stats: [ [ @differ.counts[:added] || 0, "added", :green ], [ @differ.counts[:changed] || 0, "changed", :amber ],
               [ @differ.counts[:removed] || 0, "removed", :red ] ] %>

<% case @base_status %>
<% when :current %>
  <div class="eb-banner is-ok">Built on the same version it is compared against. The diff below is exactly what this PR changes.</div>
<% when :stale %>
  <div class="eb-banner is-warn">
    <strong>Outdated base.</strong> This file was built on version <code><%= env_bro_short_digest(meta["base_digest"]) %></code>,
    not <code><%= env_bro_short_digest(@base_digest) %></code>. Changes made since then may be reverted by this PR. Look for unexpected removals or changes,
    and ask the author to rebuild the file if in doubt.
  </div>
<% else %>
  <div class="eb-banner is-warn">
    <strong>Not built with EnvBro.</strong> The file has no EnvBro metadata, so it may have been edited by hand or be an older copy of the file.
    Check every change below carefully.
  </div>
<% end %>

<div class="bh-split">
  <div class="bh-split-main">
    <%= form_with url: reveal_review_path, method: :post, local: true, data: { turbo: false } do %>
      <%= hidden_field_tag :proposed_enc, @proposed_enc %>
      <%= hidden_field_tag :base_enc, @base_enc %>

      <div class="bh-block-head">
        <h2 class="bh-h2">Changed keys</h2>
        <% if can_reveal && changes.any? %>
          <button type="submit" name="reveal_key" value="*" class="eb-add">Reveal all values</button>
        <% end %>
      </div>

      <div class="eb-summary-tags">
        <% %i[added changed removed].each do |status| %>
          <%= content_tag :span, "#{@differ.counts[status] || 0} #{status}", class: "bh-tag #{EnvBro::ApplicationHelper::STATUS_TAGS[status.to_s]}" %>
        <% end %>
        <span class="bh-tag"><%= unchanged.size %> unchanged</span>
      </div>

      <% if changes.empty? %>
        <p class="bh-hint">No key or value differs from the base file.</p>
      <% else %>
        <div class="bh-table eb-cols-diff<%= ' no-reveal' unless can_reveal %>" style="--min: 0">
          <div class="bh-row is-head"><span>Key</span><span>Status</span><span>Before</span><span>After</span><% if can_reveal %><span></span><% end %></div>
          <% changes.each do |entry| %>
            <% revealed = @revealed.include?(entry.key) %>
            <div class="bh-row row-<%= entry.status %> <%= { 'added' => 'bh-edge-violet', 'changed' => 'bh-edge-amber', 'removed' => 'bh-edge-red' }[entry.status.to_s] %>">
              <span class="bh-cell-strong" style="font-family:var(--bh-mono);font-weight:500;font-size:14px;overflow-wrap:anywhere"><%= entry.key %></span>
              <span><%= env_bro_status_badge(entry.status) %></span>
              <span><%= revealed ? env_bro_value(entry.old_value) : env_bro_masked(entry.old_value) %></span>
              <span><%= revealed ? env_bro_value(entry.new_value) : env_bro_masked(entry.new_value) %></span>
              <% if can_reveal %>
                <span>
                  <% unless revealed %>
                    <button type="submit" name="reveal_key" value="<%= entry.key %>" class="btn-link">reveal</button>
                  <% end %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if can_reveal %>
          <p class="eb-note">Revealing values is recorded in the audit log.</p>
        <% end %>
      <% end %>

      <% if unchanged.any? %>
        <details class="eb-details" style="margin-top:32px">
          <summary><%= unchanged.size %> unchanged keys</summary>
          <% unchanged.each do |entry| %>
            <div class="eb-unchanged-key row-unchanged"><%= entry.key %></div>
          <% end %>
        </details>
      <% end %>
    <% end %>
  </div>

  <div class="bh-split-aside">
    <section class="bh-block">
      <h2 class="bh-h2">Proposal</h2>
      <% if meta %>
        <dl class="bh-dl">
          <dt>Author</dt><dd><%= meta["proposed_by"].presence || "unknown" %></dd>
          <dt>Built at</dt><dd><%= meta["proposed_at"] %></dd>
          <dt>Built on</dt><dd><code><%= env_bro_short_digest(meta["base_digest"]) %></code></dd>
          <% if @proposal_event %>
            <dt>Status</dt><dd><%= env_bro_deployment_badge(@proposal_event, EnvBro::AuditEvent.live_proposal) %></dd>
          <% end %>
        </dl>
        <% if Array(meta["changes"]).any? %>
          <p class="eb-note">Changes declared by the author:</p>
          <ul class="eb-steps">
            <% Array(meta["changes"]).each do |c| %><li><code><%= c %></code></li><% end %>
          </ul>
        <% end %>
      <% else %>
        <p class="bh-hint">No EnvBro metadata in this file.</p>
      <% end %>
    </section>

    <section class="bh-block">
      <h2 class="bh-h2">Before merging</h2>
      <ol class="eb-steps">
        <li>Every changed key is expected and matches the PR description.</li>
        <li>No unexpected removals (a sign of an outdated or replaced file).</li>
        <li>The PR changes only <code><%= @environment.filename %></code>, nothing else.</li>
      </ol>
    </section>
  </div>
</div>
