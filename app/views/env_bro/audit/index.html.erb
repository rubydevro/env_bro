<% env_bro_styles %>
<% bro_hub_crumb "Audit log" %>
<%= bro_hub_hero eyebrow: "Audit log · #{@environment.name}", title: @events.size.to_s, subtitle: (@events.size == 1 ? "event" : "events"), tone: :green,
      lead: "Who proposed, reviewed or revealed what, and when proposals went live. Key names only, never values." %>

<% if @events.empty? %>
  <div class="bh-table-wrap"><div class="bh-empty">Nothing recorded yet.</div></div>
<% else %>
  <div class="bh-table-wrap">
    <div class="bh-table eb-cols-audit">
      <div class="bh-row is-head"><span>When</span><span>Who</span><span>Event</span><span>Keys</span><span>Status</span></div>
      <% @events.each do |event| %>
        <div class="bh-row">
          <span class="bh-cell-muted" title="<%= event.created_at.utc.iso8601 %>"><%= env_bro_time(event.created_at) %></span>
          <span class="bh-cell-strong"><%= event.user_label %></span>
          <span><span class="bh-tag"><%= event.event.humanize %></span></span>
          <span><%= safe_join(event.keys, tag.br) %></span>
          <span>
            <% if event.event == "proposal_created" %>
              <%= env_bro_deployment_badge(event, @live_proposal) %>
            <% elsif event.modified_after_review? %>
              <span class="bh-tag is-amber" title="The deployed file is not the one EnvBro built. It was re-encrypted after review.">modified after review</span>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
